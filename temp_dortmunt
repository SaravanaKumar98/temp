func (c *GoogleMapsClient) FindPlace(ctx context.Context, place string) (string, float64, float64, error) {
	// First geocode the city name (query) to get Lat/Lng
	geoReq := &maps.GeocodingRequest{Address: place}
	geoResults, err := c.client.Geocode(ctx, geoReq)
	if err != nil || len(geoResults) == 0 {
		return "", 0, 0, fmt.Errorf("geocoding failed for %s: %v", place, err)
	}

	// Take first result lat/lng
	latlng := geoResults[0].Geometry.Location

	// Now call FindPlaceFromText with location bias
	req := &maps.FindPlaceFromTextRequest{
		Input:     place,
		InputType: "textquery",
		LocationBias: &maps.LocationBiasCircular{
			Center: &maps.LatLng{Lat: latlng.Lat, Lng: latlng.Lng},
			Radius: 50000, // 50km bias radius
		},
		Fields: []maps.PlaceSearchFieldMask{
			maps.PlaceSearchFieldMaskName,
			maps.PlaceSearchFieldMaskFormattedAddress,
			maps.PlaceSearchFieldMaskGeometry,
		},
	}

	response, err := c.client.FindPlaceFromText(ctx, req)
	if err != nil {
		return "", 0, 0, fmt.Errorf("FindPlaceFromText failed: %v", err)
	}
	if len(response.Candidates) == 0 {
		return "", 0, 0, fmt.Errorf("no place found for %s", place)
	}

	// Take best candidate
	candidate := response.Candidates[0]
	return candidate.FormattedAddress, candidate.Geometry.Location.Lat, candidate.Geometry.Location.Lng, nil
}
